---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '老张 · 纺织制造数字化笔记',
  description = 'ERP / MES 实施、AI 落地、项目交付——一个在车间里做方案、跑现场的人，把踩过的坑和想明白的事写在这里。',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@300;400;500&family=Noto+Serif+SC:wght@500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
